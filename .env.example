# Copy to .env.local and fill in. Never commit a filled-in copy.
#
# Values here are placeholders, not real credentials. Every variable the app
# reads is listed. The NEXT_PUBLIC_* pair is checked at startup by
# apps/web/src/lib/env.ts, which fails naming any that is missing; each other
# section says who reads its variables and checks them on first use.
#
# This file lives at the repository root and stays there. next.config.ts and
# db/drizzle.config.ts load it explicitly — neither Next nor drizzle-kit looks
# at the repository root on its own.

# ---------------------------------------------------------------------------
# Supabase — browser-visible. Ships in the JS bundle by design.
# ---------------------------------------------------------------------------
# `supabase start` prints both. The publishable key replaces the deprecated
# `anon` key, which Supabase is retiring by the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ---------------------------------------------------------------------------
# Supabase — server only. Never referenced from a client component.
# ---------------------------------------------------------------------------
# The secret key replaces the deprecated `service_role` key. It bypasses row
# level security, so it belongs only in server code and 401s from a browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# ---------------------------------------------------------------------------
# Database — Drizzle and drizzle-kit only.
# ---------------------------------------------------------------------------
# `supabase start` prints this. See db/README.md before pointing an
# application query path at it: the default `postgres` role bypasses row level
# security two different ways, so this connection string is for schema
# introspection (`pnpm db:pull`), not for serving user data.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
